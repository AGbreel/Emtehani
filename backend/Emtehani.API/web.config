<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- IIS rejects large bodies before Kestrel sees them (30 MB default).
         Keep this in sync with Uploads:MaxMediaBytes (200 MB default). -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="220200960" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
